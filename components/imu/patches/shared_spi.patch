+namespace {
+class SelectedSpiDevice {
+public:
+    SelectedSpiDevice(spi_device_handle_t device, gpio_num_t chip_select, gpio_num_t ready_pin)
+        : device_(device), chip_select_(chip_select),
+          acquired_(false)
+    {
+        acquired_ = spi_device_acquire_bus(device, portMAX_DELAY) == ESP_OK;
+        if (acquired_ && gpio_get_level(ready_pin) != 0) {
+            spi_device_release_bus(device_);
+            acquired_ = false;
+        }
+        if (acquired_) {
+            // ESP32-S3 latches clock polarity when a transaction starts.
+            // Apply mode 3 while CS is high before selecting the IMU.
+            spi_transaction_t setup{};
+            if (spi_device_polling_transmit(device_, &setup) != ESP_OK) {
+                spi_device_release_bus(device_);
+                acquired_ = false;
+                return;
+            }
+            gpio_set_level(chip_select_, 0);
+        }
+    }
+    ~SelectedSpiDevice()
+    {
+        if (acquired_) {
+            gpio_set_level(chip_select_, 1);
+            spi_device_release_bus(device_);
+        }
+    }
+    explicit operator bool() const { return acquired_; }
+    SelectedSpiDevice(const SelectedSpiDevice&) = delete;
+    SelectedSpiDevice& operator=(const SelectedSpiDevice&) = delete;
+private:
+    spi_device_handle_t device_;
+    gpio_num_t chip_select_;
+    bool acquired_;
+};
+}
 

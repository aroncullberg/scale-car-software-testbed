CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MASTER_LEVEL=y

CONFIG_RCLINK_PROTOCOL_AUTO=y
CONFIG_RCLINK_UART=1
CONFIG_RCLINK_RX_PIN=16
CONFIG_RCLINK_TX_PIN=17
CONFIG_RCLINK_TIMEOUT_MS=300
CONFIG_RCLINK_DEADBAND=100
CONFIG_RCLINK_ZERO_LQ_FAILSAFE=y
CONFIG_RCLINK_HEARTBEAT_MS=0

CONFIG_DSHOT_DEFAULT_D600=y
CONFIG_DSHOT_DEFAULT_BIDIRECTIONAL=y
CONFIG_DSHOT_DEFAULT_FRAME_HZ=1000
CONFIG_DSHOT_DEFAULT_STARTUP_LOW_MS=300
CONFIG_DSHOT_DEFAULT_TASK_PRIORITY=20
CONFIG_DSHOT_DEFAULT_TASK_CORE=0
CONFIG_DSHOT_TIMING_DIAGNOSTICS=y

# UART1 is RC and UART2 is GPS; passthrough borrows UART0 on the motor pins.
CONFIG_ESC_PASSTHROUGH_UART=0

# Keep IMU processing on the sensor interrupt core.
CONFIG_ESP32_BNO08X_CB_TASK_AFFINITY=1
CONFIG_ESP32_BNO08X_DATA_PROC_TASK_AFFINITY=1
CONFIG_ESP32_BNO08X_SH2_HAL_SERVICE_TASK_AFFINITY=1

# Keep Wi-Fi service work off the DShot core.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
